  "plans": [
    {
      "id": "coding-token-plan",
      "name_zh": "编程Token Plan（积分版）",
      "base_url": "https://ai.ctaigw.cn/coding/v1",
      "protocol": "openai-chat",
      "anthropic_base_url": "https://ai.ctaigw.cn/coding",
      "price_cny_month": {
        "3000积分": 29,
        "10000积分": 89,
        "25000积分": 199,
        "50000积分": 399,
        "100000积分": 699
      },
      "quota_note": "按积分计量，积分↔Token 兑换按模型不同（如 DeepSeek-V4-Pro 1积分≈输入1111/输出370 Token，minimax-M3 1积分≈输入4762/输出1190 Token）。『仅限在AI 编程工具中使用，不可用于 API 调用的形式用于自动化脚本、自定义应用程序后端或任何非交互式批量调用场景。违规使用可能导致停用或APP Key封禁。』同一主账号同时只能购买使用一个套餐、仅主账号可购；禁止共享；暂不支持自动续订；不支持退订/退款。模型库动态更新、不承诺固定模型。旧版按 Token 计量套餐（2500万/8000万/1.8亿/3.8亿/6.8亿 Token，29–699元/月，模型 DeepSeek-V4-Flash-0731、GLM-5.1、GLM-5.2）仅存量续订。",
      "models": [
        "DeepSeek-V4-Pro",
        "DeepSeek-V4-Flash-0731",
        "GLM-5.2",
        "GLM-5.1",
        "Kimi-K2.6",
        "MiniMax-M3"
      ],
      "source": "https://www.ctyun.cn/document/11061839/11095143",
      "sources": [
        "https://www.ctyun.cn/document/11061839/11095143",
        "https://www.ctyun.cn/document/11061839/11092368",
